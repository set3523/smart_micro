      </Attribute>
    </Grid>
    <Grid Name="E_field_Lagrange" GridType="Collection" CollectionType="Temporal">
      <Grid Name="E_field_Lagrange" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="real_E_field_Lagrange" AttributeType="Vector" Center="Node">
